//------------------------------------------------
//--- 010 Editor v13.0.2 二进制模板
//
//      File: DSAProj.bt
//   Authors: Meowmaritus
//   Version: 2
// File Mask: *.dsaproj
//  ID Bytes: 44 50 52 4A
//------------------------------------------------

local int MAX_SUPPORTED_FILE_VERSION = 3;

typedef struct
{
    ubyte HasValue;
    if (HasValue != 0)
    {
        wstring Value;
    }
} NullPrefixUTF16;

typedef struct 
{
    int Type;
    float StartTime;
    float EndTime;
    int GroupIndex;
    int Unk04;
    int paramByteCount;
    ubyte ParameterBytes[paramByteCount];
    NullPrefixUTF16 EditorText;
} Event;

char magic[4]; Assert(magic == "DSCB");
// 这里的 FILE_VERSION 与主 DSAProj 格式一致。
// 如果新版本给 NullPrefixUTF16 或 Event 加了新字段，
// 你也必须把它们同步加进本模板里的事件结构体。
int FILE_VERSION;
Assert(FILE_VERSION <= MAX_SUPPORTED_FILE_VERSION);
int eventCount;
Event Events[eventCount] <optimize=false>;